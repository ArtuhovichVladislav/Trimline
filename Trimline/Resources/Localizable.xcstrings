    "The file can’t be read. Check that it’s still available and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei kann nicht gelesen werden. Prüfe, ob sie noch verfügbar ist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer el archivo. Comprueba que sigue disponible e inténtalo de nuevo."
          }
        },
        "fr": {
