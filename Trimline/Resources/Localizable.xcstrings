{
  "sourceLanguage": "en",
  "strings": {
    "%@ License": {
      "comment": "License sheet title; the argument is a library name such as FFmpeg.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Lizenz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Licencia de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Licence de %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenza di %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のライセンス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사용권"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Licença do %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лицензия %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліцензія %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 许可证"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 授權條款"
          }
        }
      }
    },
    "%@ is replaced with the original file’s name.": {
      "comment": "Settings: the token is {name}",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird durch den Namen der Originaldatei ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se sustituye por el nombre del archivo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est remplacé par le nom du fichier d’origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene sostituito dal nome del file originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は元のファイル名に置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 자리에 원본 파일 이름이 들어갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é substituído pelo nome do arquivo original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заменяется именем исходного файла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ замінюється назвою вихідного файлу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会替换为原文件的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會取代為原始檔案的名稱。"
          }
        }
      }
    },
    "%@ needed, %@ available.": {
      "comment": "Disk space: required size, free size.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt, %2$@ verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ needed, %2$@ available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan %1$@, hay %2$@ disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ requis, %2$@ disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ necessari, %2$@ disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な容量: %1$@、空き容量: %2$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 필요, %2$@ 사용 가능."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ necessários, %2$@ disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно %1$@, доступно %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно %1$@, доступно %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 %1$@，可用 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 %1$@，可用 %2$@。"
          }
        }
      }
    },
    "%@ on GitHub": {
      "comment": "Help menu item that opens the project page; the argument is the app name, Trimline.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf GitHub"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en GitHub"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur GitHub"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ su GitHub"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubの%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub의 %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no GitHub"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на GitHub"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на GitHub"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上的 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上的 %@"
          }
        }
      }
    },
    "%@ – %@, length %@. The new file is saved next to the original.": {
      "comment": "Save sheet: clip start, clip end, clip length.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, Dauer %3$@. Die neue Datei wird neben dem Original gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, length %3$@. The new file is saved next to the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, duración %3$@. El nuevo archivo se guarda junto al original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, durée %3$@. Le nouveau fichier est enregistré à côté de l’original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, durata %3$@. Il nuovo file viene salvato accanto all’originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@、長さ %3$@。新しいファイルは元のファイルと同じ場所に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, 길이 %3$@. 새 파일은 원본과 같은 위치에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, duração %3$@. O novo arquivo é salvo ao lado do original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагмент %1$@ – %2$@, длина %3$@. Новый файл появится рядом с исходным."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагмент %1$@ – %2$@, тривалість %3$@. Новий файл з’явиться поруч із вихідним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@，时长 %3$@。新文件将保存在原文件旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@，長度 %3$@。新檔案會儲存在原始檔案旁邊。"
          }
        }
      }
    },
    "%@ – %@, length %@. You’ll choose where to save the new file.": {
      "comment": "Save sheet when the location is chosen in a save panel: clip start, clip end, clip length.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, Dauer %3$@. Du wählst aus, wo die neue Datei gesichert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, length %3$@. You’ll choose where to save the new file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, duración %3$@. Elegirás dónde guardar el nuevo archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, durée %3$@. Vous choisirez l’emplacement du nouveau fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, durata %3$@. Sceglierai dove salvare il nuovo file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@、長さ %3$@。新しいファイルの保存先はこのあと選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, 길이 %3$@. 새 파일을 저장할 위치를 선택하게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, duração %3$@. Você escolherá onde salvar o novo arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагмент %1$@ – %2$@, длина %3$@. Место для нового файла вы выберете сами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагмент %1$@ – %2$@, тривалість %3$@. Місце для нового файлу ви виберете самі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@，时长 %3$@。你将选择新文件的保存位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@，長度 %3$@。你將選擇新檔案的儲存位置。"
          }
        }
      }
    },
    "A file with this name already exists. Choose another name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei mit diesem Namen existiert bereits. Wähle einen anderen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un archivo con este nombre. Elige otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier portant ce nom existe déjà. Choisissez un autre nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un file con questo nome. Scegli un altro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前のファイルはすでに存在します。別の名前を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 파일이 이미 있습니다. 다른 이름을 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um arquivo com este nome. Escolha outro nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл с таким именем уже существует. Выберите другое имя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл із такою назвою вже існує. Виберіть іншу назву."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名文件。请选择其他名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名的檔案。請選擇其他名稱。"
          }
        }
      }
    },
    "A name can’t contain “/”, “:” or line breaks.": {
      "comment": "Settings: invalid clip name template",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name darf kein „/“, kein „:“ und keine Zeilenumbrüche enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre no puede contener “/”, “:” ni saltos de línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom ne peut pas contenir « / », « : » ni de retour à la ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome non può contenere “/”, “:” né interruzioni di riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に「/」、「:」、改行を含めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에 ‘/’, ‘:’ 또는 줄 바꿈을 포함할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome não pode conter “/”, “:” nem quebras de linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя не может содержать «/», «:» и переносы строк."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва не може містити «/», «:» і розриви рядків."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称不能包含“/”、“:”或换行符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱不能包含「/」、「:」或換行字元。"
          }
        }
      }
    },
    "A name can’t start with a dot.": {
      "comment": "Settings: invalid clip name template",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name darf nicht mit einem Punkt beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre no puede empezar por un punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom ne peut pas commencer par un point."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome non può iniziare con un punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の先頭にピリオドは使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 마침표로 시작할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome não pode começar com um ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя не может начинаться с точки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва не може починатися з крапки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称不能以句点开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱不能以句點開頭。"
          }
        }
      }
    },
